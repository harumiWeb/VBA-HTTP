{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vba-http.local/schemas/cancellation-stress-result.schema.json",
  "title": "VBA-HTTP Phase 9 cancellation and timeout stress result",
  "type": "object",
  "required": ["schema_version", "benchmark", "source_commit", "environment", "server", "parameters", "results"],
  "properties": {
    "schema_version": { "const": 1 },
    "benchmark": { "const": "phase9-cancellation-stress" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "environment": {
      "type": "object",
      "required": ["platform", "powershell", "processor_architecture"],
      "properties": {
        "platform": { "const": "Windows" },
        "powershell": { "type": "string", "minLength": 1 },
        "processor_architecture": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "server": {
      "type": "object",
      "required": ["base_url", "external_network"],
      "properties": {
        "base_url": { "type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost)(:[0-9]+)?$" },
        "external_network": { "const": false }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "required": ["iterations", "com_cancellation_requests", "com_deadline_requests", "com_timeout_receive_milliseconds", "com_timeout_delay_milliseconds", "native_download_bytes", "native_download_cancel_after_bytes", "idle_wait_ms", "idle_settle_max_ms", "handle_delta_limits"],
      "properties": {
        "iterations": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "com_cancellation_requests": { "const": 4 },
        "com_deadline_requests": { "const": 4 },
        "com_timeout_receive_milliseconds": { "const": 1000 },
        "com_timeout_delay_milliseconds": { "const": 10000 },
        "native_download_bytes": { "const": 65536 },
        "native_download_cancel_after_bytes": { "const": 65536 },
        "idle_wait_ms": { "const": 1000 },
        "idle_settle_max_ms": { "const": 30000 },
        "handle_delta_limits": {
          "type": "object",
          "required": ["native", "com"],
          "properties": { "native": { "const": 8 }, "com": { "const": 32 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "processSnapshot": {
      "type": "object",
      "required": ["observed", "process_count", "handles", "working_set_bytes", "private_bytes"],
      "properties": {
        "observed": { "type": "boolean" },
        "process_count": { "type": "integer", "minimum": 1 },
        "handles": { "type": "integer", "minimum": 0 },
        "working_set_bytes": { "type": "integer", "minimum": 0 },
        "private_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": ["scenario", "transport", "iterations", "status", "elapsed_ms", "handle_delta", "idle_handle_delta", "handle_delta_limit", "invariant", "process_before", "process_peak", "process_after", "process_idle_after"],
      "properties": {
        "scenario": { "enum": ["com_active_cancellation", "com_request_deadline", "com_receive_timeout", "native_download_cancellation"] },
        "transport": { "enum": ["WinHttpComTransport", "WinHttpNativeTransport"] },
        "iterations": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "status": { "const": "passed" },
        "elapsed_ms": { "type": "number", "exclusiveMinimum": 0 },
        "handle_delta": { "type": "integer" },
        "idle_handle_delta": { "type": "integer" },
        "handle_delta_limit": { "type": "integer", "minimum": 0 },
        "invariant": { "type": "string", "minLength": 1 },
        "process_before": { "$ref": "#/$defs/processSnapshot" },
        "process_peak": { "$ref": "#/$defs/processSnapshot" },
        "process_after": { "$ref": "#/$defs/processSnapshot" },
        "process_idle_after": { "$ref": "#/$defs/processSnapshot" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
